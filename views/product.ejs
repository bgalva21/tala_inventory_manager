<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>Document</title>
</head>
<body>
    <% if(product) { %> 
        <div class="header" >
            <a href="/products">< Back</a>
            <h1><%= product[0].product_name %> </h1>
        </div>
        <form action="/product/v1/<%=product[0].product_id %>" method="POST" class="edit-product-form" >
            <div class="form-group" >
                <label for="name">Name</label>
                <input type="text" name="name" id="name" value="<%=product[0].product_name %>">
            </div>
            
            <div class="form-group" >
                <label for="description">Description</label>
                <input type="text" name="description" id="description" value="<%=product[0].description %>">
            </div>
            
            <div class="form-group" >
                <label for="price">Price</label>
                <input type="text" name="price" id="price" value="<%=product[0].price %>">
            </div>
            
            <div class="form-group" >
                <label for="stock">Items in Stock</label>
                <input type="stock" name="stock" id="stock" value="<%=product[0].stock %>">
            </div>
                    
            <button type="submit">Submit</button>
        </form>

        <form action="/delete/product/v1/<%=product[0].product_id %>" method="POST">
            <button type="submit" class="delete-btn">DELETE PRODUCT</button>
        </form>

    <% } %>
</body>
</html>