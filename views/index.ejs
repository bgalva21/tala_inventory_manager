<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>TD Product Hub</title>
</head>
<body>
    <h1>TalaveraDumont Product Hub</h1>

        <div class="product-section" >
            <div class="category-buttons">
                <form action="/products" method="GET">
                    <button
                        type="submit"
                    >
                    All</button>
                    <% categories.forEach(category => { %>
                        <button
                            type="submit"
                            name="category"
                            value="<%= category.category_id %>"
                        >
                            <%= category.name %>
                        </button>
                    <% }) %>
                </form>
                <form action="/category" method="GET" >
                    <button
                        type="submit"
                        name="form"
                        value="create"
                    >
                        add category
                    </button>
                </form>

                <form action="/category" method="GET">
                    <button
                        type="submit"
                        name="form"
                        value="delete"
                    >
                    delete category
                    </button>
                </form>
                
            </div>
            <table>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Price </th>
                    <th>Stock 
                        <div class="sort-btns">
                                <form action="/products" method="GET">
                                    <% if(selectedCategory){ %>
                                        <input 
                                            type="hidden"
                                            name="category"
                                            value="<%= selectedCategory %>"
                                        >
                                    <% } %>
                                    <button
                                        type="submit"
                                        name="sort"
                                        value="DESC"
                                    >
                                        ↑
                                    </button>
                                    <button
                                        type="submit"
                                        name="sort"
                                        value="ASC"
                                    >
                                        ↓
                                    </button>
                                </form>
                            </div>
                    </th>
                    <th>Total Value</th>
                    <th>
                        <form action="/create" method="GET">
                            <button type="submit">create a product</button>
                        </form>
                    </th>
                </tr>
                <tbody>
                <% for(let i = 0; i < products.length; i++ ){ %>
                    <tr>
                        <td class="td-row" ><p><%= i + 1%></p> <%= products[i].product_name %></td>
                        <td><%= products[i].description %></td>
                        <td><%= products[i].price %></td>
                        <td><%= products[i].stock %></td>
                        <td>$<%= (parseFloat(products[i].price.replace("$","")) * products[i].stock).toFixed(2) %></td>
                        <td><form action="/product/v1/<%= products[i].product_id %>" method="GET"><button type="submit">Edit item</button></form></td>
                    </tr>
                <% } %>
                </tbody>
            </table>
        </div>
</body>
</html>